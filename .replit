modules = ["nodejs-20", "python-3.12", "web"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
MONGO_URL = "mongodb://localhost:27017"
DB_NAME = "vianord"
REACT_APP_BACKEND_URL = ""
PORT = "5000"
HOST = "0.0.0.0"
SUPABASE_URL = "https://bwdcsmcetvohatcczptg.supabase.co"
SUPABASE_KEY = "sb_publishable_Qy6WeoJ6lrME0KeVEcqCRQ_4Bu_KXQh"
ADMIN_NOTIFY_EMAIL = "info@vianordtrans.es"
SENDER_EMAIL = "ViaNordTrans <info@vianordtrans.es>"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 23636
externalPort = 3000

[deployment]
deploymentTarget = "vm"
run = ["bash", "/home/runner/workspace/backend/start_prod.sh"]
build = ["bash", "-c", "cd /home/runner/workspace/frontend && yarn build && chmod +x /home/runner/workspace/backend/start_prod.sh"]
